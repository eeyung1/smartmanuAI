# Local setup: run npm run setup:local. Never put production secrets in this file.
SMARTMANU_MODE=local
BETTER_AUTH_URL=http://127.0.0.1:3000
BETTER_AUTH_SECRET=
# Hosted read-only preview (set through Vercel, not this example):
# SMARTMANU_MODE=staging
# BETTER_AUTH_URL=https://YOUR-PROJECT.vercel.app
# SMARTMANU_SUPABASE_PROJECT_REF=
# DATABASE_URL=postgresql://smartmanuai_reader.PROJECT_REF:PASSWORD@POOLER_HOST:6543/postgres
# Staging uses verified TLS, the private smartmanuai schema, and no runtime migrations.
# Leave collection, paid research and email/Telegram/delivery modes unset in staging.
