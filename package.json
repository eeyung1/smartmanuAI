{
  "name": "smartmanuai",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test --test-concurrency=1 tests/*.test.ts",
    "format:check": "prettier --check app src agent scripts tests db package.json tsconfig.json next.config.ts",
    "db:migrate": "node --env-file=.env.local --import tsx scripts/migrate.ts",
    "spike": "node --env-file=.env.local --import ./scripts/local-network-guard.mjs --import tsx scripts/spike.ts",
    "agent:build": "node --env-file=.env.local --import ./scripts/local-network-guard.mjs node_modules/eve/bin/eve.js build",
    "agent:start": "node --env-file=.env.local --import ./scripts/local-network-guard.mjs node_modules/eve/bin/eve.js start --host 127.0.0.1 --port 3100",
    "test:http": "node --env-file=.env.local --import tsx scripts/http-spike.ts",
    "check": "npm run format:check && npm run typecheck && npm test && npm run build && npm run test:http && npm run agent:build && npm run spike",
    "setup:local": "node scripts/setup-local.mjs",
    "seed:local": "node --env-file=.env.local --import tsx scripts/seed-local.ts",
    "admin:grant": "node --env-file=.env.local --import tsx scripts/grant-admin.ts",
    "research:once": "node --env-file=.env.local --import tsx scripts/research-once.ts"
  },
  "dependencies": {
    "@electric-sql/pglite": "0.5.13",
    "ai": "7.0.156",
    "better-auth": "1.7.14",
    "drizzle-orm": "0.45.4",
    "eve": "0.87.0",
    "just-bash": "3.6.0",
    "next": "16.4.3",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  },
  "overrides": {
    "undici@^7": "7.30.1",
    "undici@^8": "8.12.3"
  }
}
